{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OSharp": {
    "DbContexts": {
      //#if (mysql)
      "MySql": {
        "DbContextTypeName": "OSharp.Entity.DefaultDbContext,OSharp.EntityFrameworkCore",
        "ConnectionString": "Server=localhost;Port=3306;User Id=root;Password=CHANGE_ME;Database=app_dev;Charset=utf8mb4;Allow User Variables=True",
        "DatabaseType": "MySql",
        "LazyLoadingProxiesEnabled": true,
        "AuditEntityEnabled": true,
        "AutoMigrationEnabled": false
      }
      //#endif
      //#if (mssql)
      "SqlServer": {
        "DbContextTypeName": "OSharp.Entity.DefaultDbContext,OSharp.EntityFrameworkCore",
        "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=app_dev;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
        "DatabaseType": "SqlServer",
        "LazyLoadingProxiesEnabled": true,
        "AuditEntityEnabled": true,
        "AutoMigrationEnabled": false
      }
      //#endif
      //#if (sqlite)
      "Sqlite": {
        "DbContextTypeName": "OSharp.Entity.DefaultDbContext,OSharp.EntityFrameworkCore",
        "ConnectionString": "Data Source=app.db",
        "DatabaseType": "Sqlite",
        "LazyLoadingProxiesEnabled": true,
        "AuditEntityEnabled": true,
        "AutoMigrationEnabled": false
      }
      //#endif
      //#if (pgsql)
      "PostgreSql": {
        "DbContextTypeName": "OSharp.Entity.DefaultDbContext,OSharp.EntityFrameworkCore",
        "ConnectionString": "Host=localhost;Port=5432;Database=app_dev;Username=postgres;Password=CHANGE_ME",
        "DatabaseType": "PostgreSql",
        "LazyLoadingProxiesEnabled": true,
        "AuditEntityEnabled": true,
        "AutoMigrationEnabled": false
      }
      //#endif
      //#if (oracle)
      "Oracle": {
        "DbContextTypeName": "OSharp.Entity.DefaultDbContext,OSharp.EntityFrameworkCore",
        "ConnectionString": "User Id=CHANGE_ME;Password=CHANGE_ME;Data Source=localhost:1521/FREEPDB1",
        "DatabaseType": "Oracle",
        "LazyLoadingProxiesEnabled": true,
        "AuditEntityEnabled": true,
        "AutoMigrationEnabled": false
      }
      //#endif
    },
    "OAuth2": {},
    "Jwt": {
      "Enabled": false
    },
    "Cookie": {
      "Enabled": true
    },
    "Mvc": {
      "IsLowercaseJsonProperty": true,
      "IsLowercaseUrls": true
    },
    "Cors": {
      "PolicyName": "DefaultCors",
      "AllowAnyHeader": true,
      "WithMethods": [ "GET", "POST", "PUT", "DELETE" ],
      "WithOrigins": [],
      "Enabled": true
    },
    "Swagger": {
      "Endpoints": [
        {
          "Title": "OSharp API",
          "Version": "v1",
          "Url": "/swagger/v1/swagger.json"
        },
        {
          "Title": "Business API",
          "Version": "buss",
          "Url": "/swagger/buss/swagger.json"
        }
      ],
      "RoutePrefix": "swagger",
      "IsHideSchemas": false,
      "MiniProfiler": false,
      "Enabled": true
    }
  }
}
